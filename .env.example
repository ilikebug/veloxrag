# POSTGRES_* configure the local container. RAG_DATABASE_URL below is independent;
# keep its database and credentials aligned, percent-encoding URL special characters.
POSTGRES_DB=rag
POSTGRES_USER=rag
POSTGRES_PASSWORD=change-me-local

# Local application image tag shared by migrate, API, Worker, and the optional
# deterministic Provider stub.
# Consumers pull the published image; leave these unset to use the default.
# `make start` sets them for a source build.
VELOX_IMAGE=veloxrag
VELOX_IMAGE_TAG=local

# MINIO_ROOT_* configure the local server. Keep the RAG_MINIO_* client values aligned.
MINIO_ROOT_USER=rag-dev
MINIO_ROOT_PASSWORD=change-me-local

# Host-side port publishing only; containers reach each other by service name, so
# these never have to be matched elsewhere. Commented out because compose already
# defaults to the same values — uncomment one when it collides with something on
# this machine. Changing RAG_API_HOST_PORT also means setting RAG_MCP_BASE_URL.
# RAG_API_HOST_PORT=8000
# RAG_POSTGRES_HOST_PORT=5432
# RAG_QDRANT_HOST_PORT=6333
# RAG_QDRANT_GRPC_HOST_PORT=6334
# RAG_REDIS_HOST_PORT=6379
# RAG_MINIO_HOST_PORT=9000
# RAG_MINIO_CONSOLE_HOST_PORT=9001

RAG_ENVIRONMENT=local
RAG_API_HOST=0.0.0.0
# Port inside the container, not the published one; that is RAG_API_HOST_PORT.
RAG_API_PORT=8000
# This URL is passed through directly; encode special characters in credentials as %XX.
RAG_DATABASE_URL=postgresql+psycopg://rag:change-me-local@postgres:5432/rag
RAG_REDIS_URL=redis://redis:6379/0
RAG_QDRANT_URL=http://qdrant:6333
RAG_QDRANT_CONNECT_TIMEOUT_SECONDS=5.0
RAG_QDRANT_REQUEST_TIMEOUT_SECONDS=30.0
RAG_MINIO_URL=http://minio:9000
RAG_MINIO_ACCESS_KEY=rag-dev
RAG_MINIO_SECRET_KEY=change-me-local
RAG_MINIO_BUCKET=rag-documents
RAG_INGESTION_NOTIFY_TIMEOUT_SECONDS=0.25
# Ingestion streams uploads with a bounded buffer. S3-compatible multipart parts
# must remain between 5 MiB and 5 GiB.
RAG_MAX_UPLOAD_BYTES=52428800
RAG_UPLOAD_BUFFER_BYTES=1048576
RAG_MINIO_MULTIPART_PART_SIZE_BYTES=5242880
RAG_MINIO_OPERATION_TIMEOUT_SECONDS=300.0
RAG_MINIO_INIT_MAX_ATTEMPTS=30
RAG_WORKER_POLL_INTERVAL_SECONDS=1.0
RAG_WORKER_LEASE_SECONDS=60.0
RAG_WORKER_HEARTBEAT_SECONDS=15.0
RAG_WORKER_MAX_ATTEMPTS=5
RAG_WORKER_RETRY_INITIAL_SECONDS=5.0
RAG_WORKER_RETRY_MAX_SECONDS=300.0
RAG_WORKER_MAX_CONCURRENCY=4
RAG_WORKER_HEALTH_FILE=/tmp/velox-worker-health.json
# PostgreSQL is the durable Job authority. Redis notifications only wake Workers;
# queued/retry_wait/expired-lease Jobs are recovered by database polling.
RAG_ORPHAN_OBJECT_GRACE_SECONDS=86400
RAG_READINESS_TIMEOUT_SECONDS=2.0
RAG_SHUTDOWN_TIMEOUT_SECONDS=2.0

# Development only. Provider credential keys are JSON mappings of version to a
# base64-encoded 32-byte AES key. Replace this weak local keyring in production
# through an approved secret manager; API and Worker must receive the same mapping.
# Rotation order: add a new version while retaining decrypting old versions, make
# the new version active, restart and pass /ready/ingest plus /ready/retrieve,
# PATCH every Credential secret so it is re-encrypted under the active version,
# verify safe Credential key_version metadata and live ingest/search, then remove
# the old version. Back up the database and keyring separately. If every key that
# can decrypt an old Credential is lost, that secret is unrecoverable and must be
# re-entered from its trusted source.
RAG_PROVIDER_CREDENTIAL_KEYRING={"local-v1":"ZGRkZGRkZGRkZGRkZGRkZGRkZGRkZGRkZGRkZGRkZGQ="}
# Must name a version present in RAG_PROVIDER_CREDENTIAL_KEYRING. New writes and
# Credential secret PATCH operations use this version.
RAG_PROVIDER_CREDENTIAL_ACTIVE_KEY_VERSION=local-v1
# Development only. Private provider targets are forbidden in production. Normal
# OpenRouter and custom OpenAI-compatible Provider Base URLs must use HTTPS and
# pass persistence-time plus per-connection SSRF/DNS validation.
RAG_PROVIDER_ALLOW_PRIVATE_TARGETS=false
# Optional PEM bundle path for provider TLS verification. The provider-stub
# profile uses /run/rag/provider-ca/ca.pem and requires private targets=true.
RAG_PROVIDER_CA_BUNDLE=
# Development/smoke only. This is a SHA-256 digest of the Provider Authorization
# header, not the Provider secret itself. The smoke target injects a fresh value.
RAG_PROVIDER_STUB_AUTHORIZATION_SHA256=

# Development only. These server-side HMAC secrets hash API keys at rest; they are
# not API keys. Keep the admin and agent values distinct, replace both in production,
# and rotate each key class independently.
RAG_ADMIN_KEY_HMAC_SECRET=local-dev-admin-hmac-secret-not-for-production-01
RAG_AGENT_KEY_HMAC_SECRET=local-dev-agent-hmac-secret-not-for-production-02

# Local pagination and default Agent API key limits.
RAG_DEFAULT_PAGE_SIZE=20
RAG_MAX_PAGE_SIZE=100
RAG_MAX_API_KEY_REQUESTS_PER_MINUTE=10000
RAG_MAX_API_KEY_CONCURRENCY=1000

# Chunk size in Unicode codepoints. For a CJK corpus, 500 / 80 is a better start:
# a codepoint carries far more information in CJK than in English.
RAG_CHUNK_MAX_CODEPOINTS=1200
RAG_CHUNK_OVERLAP_CODEPOINTS=150
